rules_version = '2';

// MangaOS account data.
//
// Every document a reader owns is readable and writable only by that reader, and every write is
// checked for its shape: allowed keys, real types, bounded sizes. Two values can never come from
// a client — the verification badge and the role — and the only mirror a client may touch
// (`isVerified`) is accepted only while it agrees with `badges/{uid}`.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ---------------------------------------------------------------------------------------
    // Account shape
    // ---------------------------------------------------------------------------------------

    function accountFields() {
      return [
        'uid', 'email', 'username', 'displayName', 'language', 'country',
        'age', 'photo', 'setupCompleted', 'isVerified', 'createdAt', 'updatedAt'
      ];
    }

    // Fields a client may never write, in any operation.
    function guardedFields() {
      return ['verified', 'role', 'admin', 'banned', 'suspended'];
    }

    function badgeExists(uid) {
      return exists(/databases/$(database)/documents/badges/$(uid));
    }

    function arabCountries() {
      return [
        'SA', 'AE', 'KW', 'QA', 'BH', 'OM', 'YE', 'JO', 'LB', 'SY', 'PS',
        'IQ', 'EG', 'SD', 'LY', 'TN', 'DZ', 'MA', 'MR', 'SO', 'DJ', 'KM'
      ];
    }

    function smallString(value, max) {
      return value is string && value.size() <= max;
    }

    function usernameOk(data) {
      return data.username is string
        && (data.username == '' || data.username.matches('^[a-z0-9_]{3,20}$'));
    }

    function optionalCountryOk(data) {
      return !('country' in data)
        || data.country == null
        || (data.country is string && data.country in arabCountries());
    }

    function optionalAgeOk(data) {
      return !('age' in data)
        || data.age == null
        || (data.age is int && data.age >= 13 && data.age <= 99);
    }

    function optionalLanguageOk(data) {
      return !('language' in data)
        || data.language == null
        || (data.language is string && data.language in ['ar', 'en', 'ja']);
    }

    function accountValuesOk(data) {
      return data.uid is string
        && smallString(data.email, 120)
        && smallString(data.displayName, 40)
        && usernameOk(data)
        && optionalLanguageOk(data)
        && optionalCountryOk(data)
        && optionalAgeOk(data)
        && (!('photo' in data) || data.photo == null || smallString(data.photo, 140000))
        && data.setupCompleted is bool
        && data.createdAt is number
        && data.updatedAt is number;
    }

    // The mirror is allowed only when it says exactly what the badge document says, so it can
    // never be used to grant verification. It is checked only when it is being changed.
    function verificationMirrorOk(uid) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isVerified'])
        || request.resource.data.isVerified == badgeExists(uid);
    }

    match /users/{uid} {
      allow read: if isOwner(uid);

      // A new account starts incomplete: no username, no badge, no profile data from the client.
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
             'uid', 'email', 'displayName', 'username', 'setupCompleted',
             'isVerified', 'createdAt', 'updatedAt'
           ])
        && request.resource.data.uid == uid
        && request.resource.data.username == ''
        && request.resource.data.setupCompleted == false
        // The field starts false and can only ever become true through the badge document.
        && (!('isVerified' in request.resource.data) || request.resource.data.isVerified == false)
        && accountValuesOk(request.resource.data);

      // A profile edit changes values only: identity, creation time and the badge stay put.
      allow update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(accountFields())
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(guardedFields())
        && verificationMirrorOk(uid)
        && accountValuesOk(request.resource.data);

      allow delete: if isOwner(uid);

      // Library, reading state, settings, devices and notification records all live under the
      // account and are only reachable through it. Writes are bounded so a client cannot turn
      // one document into an unbounded blob.
      match /library/{itemId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.size() <= 48
          && request.resource.data.size() >= 3;
      }
      match /readingProgress/{itemId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.size() <= 16
          && request.resource.data.size() >= 1;
      }
      match /readChapters/{itemId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.size() <= 8
          && request.resource.data.size() >= 1;
      }
      match /devices/{token} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && token.size() <= 512
          && request.resource.data.token == token
          && request.resource.data.platform == 'android'
          && request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt']);
      }
      match /state/{documentId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && documentId == 'preferences'
          && request.resource.data.size() <= 64;
      }
      match /notifications/{notificationId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.size() <= 16;
      }
    }

    // A username is reserved by its owner. Creation fails for everyone else, so two devices
    // cannot claim the same name even when they ask at the same moment. Reading a single
    // reservation is what makes the availability check possible; it exposes nothing but an owner
    // id for one exact name.
    match /usernames/{name} {
      allow read: if signedIn() && name.matches('^[a-z0-9_]{3,20}$');
      allow create: if signedIn()
        && name.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && name.matches('^[a-z0-9_]{3,20}$')
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'updatedAt']);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Verification is granted outside the app (console or Admin SDK) and only read here.
    match /badges/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
