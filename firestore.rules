rules_version = '2';

// MangaOS account data. Everything a reader owns is readable and writable only by that reader;
// the two fields that grant something (verification, role) can never be written by a client.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function immutableAccountFields() {
      return ['verified', 'isVerified', 'role', 'admin', 'uid', 'createdAt'];
    }

    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && !request.resource.data.keys().hasAny(['verified', 'isVerified', 'role', 'admin']);

      // A profile edit updates fields; it may not touch identity, creation time or the badge.
      allow update: if isOwner(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(immutableAccountFields());

      allow delete: if isOwner(uid);

      // Library, reading state, settings, devices and notification records all live under the
      // account and are only reachable through it.
      match /library/{itemId} {
        allow read, write: if isOwner(uid);
      }
      match /readingProgress/{itemId} {
        allow read, write: if isOwner(uid);
      }
      match /readChapters/{itemId} {
        allow read, write: if isOwner(uid);
      }
      match /devices/{token} {
        allow read, write: if isOwner(uid);
      }
      match /state/{documentId} {
        allow read, write: if isOwner(uid);
      }
      match /notifications/{notificationId} {
        allow read, write: if isOwner(uid);
      }
    }

    // A username is reserved by its owner. Creation fails for everyone else, so two devices
    // cannot claim the same name even when they ask at the same moment.
    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Verification is granted outside the app (console or Admin SDK) and only read here.
    match /badges/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
